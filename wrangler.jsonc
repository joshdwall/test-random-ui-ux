{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test-random-ui-ux",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
